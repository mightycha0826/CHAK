# 카카오 지도 JS 키 (선택)
# 없으면 도식 관내도로 자동 폴백한다. 실지도를 쓰려면:
#   1. https://developers.kakao.com 에서 앱 생성 → JavaScript 키 복사
#   2. 플랫폼 > Web 에 도메인 등록: http://localhost:5173 과 배포 도메인
# JS 키는 도메인 제한 방식이라 클라이언트에 노출되는 게 정상이다.
VITE_KAKAO_MAP_KEY=

# 실물 태그에 구울 뿌리 주소.
# ⚠️ 태그를 굽기 전에 반드시 배포 도메인으로 고정할 것.
#    비워두면 현재 접속한 origin을 쓴다(개발용).
VITE_TAG_BASE_URL=
